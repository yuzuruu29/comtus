{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comtus",
  "version": "0.2.0",
  "identifier": "studio.comtus.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Comtus",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#0B0F1A",
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "defaultSrc": "'self'",
        "scriptSrc": "'self' https://www.paypal.com https://www.paypalobjects.com",
        "styleSrc": "'self' 'unsafe-inline'",
        "fontSrc": "'self' data:",
        "imgSrc": "'self' data: blob: https://www.paypal.com https://www.paypalobjects.com",
        "connectSrc": "'self' https://comtus-ai.vercel.app https://api.anthropic.com https://openrouter.ai https://api.groq.com https://api.deepseek.com https://api.together.xyz https://opencode.ai https://api.cerebras.ai https://generativelanguage.googleapis.com https://api.mistral.ai https://www.paypal.com https://r.jina.ai https://api.github.com",
        "frameSrc": "https://www.paypal.com https://www.sandbox.paypal.com",
        "objectSrc": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://comtus-ai.vercel.app/desktop/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5Q0ZBRjZGQzYzNTBBRjQKUldUMENqWEdiNi9QbVlmSVZ5Y2dNSHRWVG5TUVJ1Z3NMaER6eUFCTVRRNHNBR1ZYQ05oWXkrSDUK"
    }
  }
}
