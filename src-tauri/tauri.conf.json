{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comtus",
  "version": "0.1.0",
  "identifier": "studio.comtus.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Comtus — Rough thought, polished.",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0B0F1A",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "defaultSrc": "'self'",
        "scriptSrc": "'self' https://www.paypal.com https://www.paypalobjects.com https://fonts.googleapis.com",
        "styleSrc": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "fontSrc": "'self' https://fonts.gstatic.com data:",
        "imgSrc": "'self' data: blob: https://www.paypal.com https://www.paypalobjects.com",
        "connectSrc": "'self' https://api.anthropic.com https://openrouter.ai https://api.groq.com https://api.deepseek.com https://api.together.xyz https://opencode.ai https://api.cerebras.ai https://generativelanguage.googleapis.com https://api.mistral.ai https://www.paypal.com https://r.jina.ai https://api.github.com https://fonts.googleapis.com https://fonts.gstatic.com",
        "frameSrc": "https://www.paypal.com https://www.sandbox.paypal.com",
        "objectSrc": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
