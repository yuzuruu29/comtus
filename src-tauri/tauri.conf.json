{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comtus",
  "version": "0.3.2",
  "identifier": "studio.comtus.app",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://127.0.0.1:5199",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Comtus",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#14100C",
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://comtus-ai.vercel.app/desktop/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5Q0ZBRjZGQzYzNTBBRjQKUldUMENqWEdiNi9QbVlmSVZ5Y2dNSHRWVG5TUVJ1Z3NMaER6eUFCTVRRNHNBR1ZYQ05oWXkrSDUK"
    }
  }
}
